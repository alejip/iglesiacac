---
// InfoCards.astro — 3 quick-info cards shown below the hero
---

<section class="bg-brand-cream py-14 px-4">
  <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-4">

    <!-- Dirección -->
    <div class="bg-white rounded-2xl shadow-md p-6 flex flex-col gap-4 hover:shadow-lg transition-shadow duration-300">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-brand-cream flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-brand-orange" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
          </svg>
        </div>
        <h3 class="font-bold text-brand-brown text-base">Dirección</h3>
      </div>
      <p class="text-gray-600 text-sm leading-relaxed flex-1">
        C/ Sor Ángela de la Cruz 6<br/>14006 Córdoba, España
      </p>
      <a
        href="https://maps.app.goo.gl/YVrcvGYhcTeFbdbw5"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-semibold text-brand-orange hover:text-orange-700 transition-colors duration-200 mt-auto"
      >
        Cómo llegar
        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>

    <!-- Horarios -->
    <div class="bg-white rounded-2xl shadow-md p-6 flex flex-col gap-4 hover:shadow-lg transition-shadow duration-300">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-brand-cream flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-brand-orange" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
          </svg>
        </div>
        <h3 class="font-bold text-brand-brown text-base">Horarios</h3>
      </div>
      <ul class="text-sm text-gray-600 leading-relaxed space-y-1.5 flex-1">
        <li class="flex justify-between">
          <span class="font-medium text-gray-800">Oración</span>
          <span>Jueves · 20:00</span>
        </li>
        <li class="flex justify-between">
          <span class="font-medium text-gray-800">Domingo</span>
          <span>11:00 y 20:00</span>
        </li>
        <li class="flex justify-between">
          <span class="font-medium text-gray-800">Jóvenes</span>
          <span>Viernes · 19:00</span>
        </li>
      </ul>
      <a href="/#horarios" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-orange hover:text-orange-700 transition-colors duration-200 mt-auto">
        Ver todos
        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>

    <!-- Contacto -->
    <div class="bg-white rounded-2xl shadow-md p-6 flex flex-col gap-4 hover:shadow-lg transition-shadow duration-300">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-brand-cream flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-brand-orange" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
          </svg>
        </div>
        <h3 class="font-bold text-brand-brown text-base">Contacto</h3>
      </div>
      <div class="flex-1">
        <a href="tel:+34658769351" class="text-sm text-gray-600 hover:text-brand-orange transition-colors duration-200 block mb-1">
          658 76 93 51
        </a>
        <p class="text-xs text-gray-400">Oficina: L–V · 09:00–14:00</p>
      </div>
      <a
        href="https://wa.me/34658769351?text=Hola%20Comunidad%20de%20Amor%20Cristiano%2C%20me%20gustar%C3%ADa%20m%C3%A1s%20info%20para%20visitaros."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-[#25D366] text-white rounded-full text-sm font-semibold hover:bg-green-500 transition-colors duration-200 mt-auto"
      >
        <!-- WhatsApp icon -->
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Hablar por WhatsApp
      </a>
    </div>

  </div>
</section>
