---
import { Image } from 'astro:assets';
import imgNinos from '../assets/images/ministerio-ninos.jpg';
import imgJovenes from '../assets/images/ministerio-jovenes.jpg';
import imgGrupos from '../assets/images/ministerio-grupos.jpg';
import imgMisiones from '../assets/images/ministerio-misiones.jpg';
import imgObraSocial from '../assets/images/ministerio-obra-social.jpg';

const ministries = [
  {
    name: 'Niños',
    tag: 'Ministerio',
    description: 'Un espacio seguro y divertido donde los más pequeños conocen a Jesús a través de historias, juegos y canciones.',
    link: '/primera-vez#ninos',
    linkLabel: 'Saber más',
    image: imgNinos,
    iconBg: 'bg-orange-50',
    iconColor: 'text-brand-orange',
    icon: `<path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>`,
  },
  {
    name: 'Jóvenes',
    tag: 'Viernes · 19:00',
    description: 'Jóvenes que buscan vivir su fe con pasión y autenticidad. Nos reunimos los viernes para adorar, aprender y conectar.',
    link: '/jovenes',
    linkLabel: 'Ver página de jóvenes',
    image: imgJovenes,
    iconBg: 'bg-amber-50',
    iconColor: 'text-brand-brown',
    icon: `<path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"/>`,
  },
  {
    name: 'Grupos en Casas',
    tag: 'Células',
    description: 'Células de vida donde compartimos la fe en lo cotidiano. Crecemos juntos, oramos juntos y nos cuidamos mutuamente.',
    link: '/contacto',
    linkLabel: 'Únete a un grupo',
    image: imgGrupos,
    iconBg: 'bg-red-50',
    iconColor: 'text-brand-red',
    icon: `<path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>`,
  },
  {
    name: 'Misiones',
    tag: 'Local e internacional',
    description: 'Llevamos el amor de Cristo más allá de nuestras paredes. Proyectos locales e internacionales que transforman vidas.',
    link: '/contacto',
    linkLabel: 'Participar',
    image: imgMisiones,
    iconBg: 'bg-brand-cream',
    iconColor: 'text-brand-orange',
    icon: `<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM4.332 8.027a6.012 6.012 0 011.912-2.706C6.512 5.73 6.974 6 7.5 6A1.5 1.5 0 019 7.5V8a2 2 0 004 0 2 2 0 011.523-1.943A5.977 5.977 0 0116 10c0 .34-.028.675-.083 1H15a2 2 0 00-2 2v2.197A5.973 5.973 0 0110 16v-2a2 2 0 00-2-2 2 2 0 01-2-2 2 2 0 00-1.668-1.973z" clip-rule="evenodd"/>`,
  },
  {
    name: 'Obra Social',
    tag: 'Comunidad',
    description: 'Extendemos el amor de Jesús sirviendo a los más vulnerables de nuestra ciudad. Ayuda alimentaria, acompañamiento y esperanza.',
    link: '/contacto',
    linkLabel: 'Colaborar',
    image: imgObraSocial,
    iconBg: 'bg-green-50',
    iconColor: 'text-green-600',
    icon: `<path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>`,
  },
];
---

<section class="bg-white py-24 px-4">
  <div class="max-w-5xl mx-auto">

    <!-- Section header -->
    <div class="text-center mb-14">
      <span class="inline-block text-brand-orange font-semibold text-sm uppercase tracking-widest mb-3">
        Ministerios
      </span>
      <h2 class="text-4xl md:text-5xl font-extrabold text-brand-brown leading-tight">
        Un lugar para cada uno
      </h2>
      <p class="mt-4 text-gray-500 text-lg max-w-xl mx-auto">
        Hay un espacio en esta comunidad donde encajas y puedes servir.
      </p>
    </div>

    <!-- 2×2 grid — clean card layout, no absolute-positioned content -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {ministries.map(m => (
        <div class="group rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 flex flex-col">

          <!-- Image area (top) — replace src with real photos -->
          <div class="relative h-44 overflow-hidden bg-brand-beige shrink-0">
            <Image
              src={m.image}
              alt={m.name}
              class="w-full h-full object-cover opacity-60 group-hover:opacity-75 group-hover:scale-105 transition-all duration-500"
              loading="lazy"
              widths={[400, 800]}
              sizes="(max-width: 640px) 100vw, 50vw"
            />
            <!-- Gradient overlay so the tag badge is readable -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
            <!-- Tag badge — bottom-left of image, NOT overlapping the icon -->
            <span class="absolute bottom-3 left-4 text-white/90 text-[11px] font-semibold uppercase tracking-widest">
              {m.tag}
            </span>
          </div>

          <!-- Text content (below image — no overlap, no absolute positioning) -->
          <div class="flex flex-col gap-3 p-6 flex-1 bg-white">
            <!-- Icon + title row -->
            <div class="flex items-center gap-3">
              <div class={`w-10 h-10 rounded-xl ${m.iconBg} flex items-center justify-center shrink-0`}>
                <svg class={`w-5 h-5 ${m.iconColor}`} viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
                  set:html={m.icon} />
              </div>
              <h3 class="font-extrabold text-brand-brown text-lg leading-tight">{m.name}</h3>
            </div>

            <!-- Description -->
            <p class="text-gray-500 text-sm leading-relaxed flex-1">{m.description}</p>

            <!-- Link -->
            <a
              href={m.link}
              class="inline-flex items-center gap-1.5 text-brand-orange text-sm font-bold hover:gap-3 transition-all duration-200 mt-1"
            >
              {m.linkLabel}
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
