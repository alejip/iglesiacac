---
interface Props {
  /**
   * Set to true when the header sits as a transparent overlay over a dark hero.
   * Switches the navbar logo to the white version.
   * Default: false (white pill navbar → positive logo).
   */
  isHeroOverlay?: boolean;
}

const { isHeroOverlay = false } = Astro.props;

// Logo paths (files must be in public/Logos/)
const LOGO_POSITIVE = '/Logos/LogoCAC_positivo.png';
const LOGO_WHITE    = '/Logos/logoCAC_blanco.png';

// Navbar logo: white version only when overlaying a dark hero
const navbarLogo = isHeroOverlay ? LOGO_WHITE : LOGO_POSITIVE;
// Drawer logo: always positive (drawer background is always white)
const drawerLogo = LOGO_POSITIVE;

// Name text colour: white over dark hero, brown on white pill
const nameColor = isHeroOverlay ? 'text-white' : 'text-brand-brown';

const navLinks = [
  { href: '/',              label: 'Inicio' },
  { href: '/primera-vez',   label: 'Primera vez aquí' },
  { href: '/#horarios',     label: 'Horarios' },
  { href: '/predicaciones', label: 'Predicaciones' },
  { href: '/jovenes',       label: 'Jóvenes' },
  { href: '/contacto',      label: 'Contacto' },
];
---

<!-- ── Sticky Pill Navbar ───────────────────────────── -->
<header class="fixed top-3 left-0 right-0 z-50 px-4">
  <div class="max-w-5xl mx-auto bg-white/95 backdrop-blur-md rounded-full shadow-lg border border-gray-100 px-3 py-2 flex items-center justify-between gap-4">

    <!-- Logo + Name -->
    <a href="/" class="flex items-center gap-3 flex-none group" aria-label="Inicio">
      <!-- Logo image -->
      <img
        src={navbarLogo}
        alt="Logo Comunidad de Amor Cristiano"
        class="h-9 w-auto object-contain shrink-0 transition-opacity duration-200 group-hover:opacity-80"
        fetchpriority="high"
      />
      <!-- Church name: two lines on xl, hidden on smaller -->
      <div
        class={`hidden xl:block leading-tight ${nameColor}`}
        style="font-family: 'Plus Jakarta Sans', sans-serif;"
      >
        <span class="block font-extrabold text-[11px] tracking-wide uppercase">Comunidad de</span>
        <span class="block font-extrabold text-[11px] tracking-wide uppercase">Amor Cristiano</span>
      </div>
    </a>

    <!-- Nav Links — desktop only -->
    <nav class="hidden lg:flex items-center gap-0.5 flex-1 justify-center" aria-label="Navegación principal">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="px-3 py-2 text-[13px] font-medium text-gray-600 hover:text-brand-orange rounded-full hover:bg-brand-cream transition-all duration-200 whitespace-nowrap"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- CTA Buttons — desktop only -->
    <div class="hidden lg:flex items-center gap-2 flex-none">
      <a
        href="/donar"
        class="px-4 py-2 text-[13px] font-semibold border border-brand-brown text-brand-brown rounded-full hover:bg-brand-cream transition-all duration-200 whitespace-nowrap"
      >
        Donar
      </a>
      <a
        href="/primera-vez"
        class="px-4 py-2 text-[13px] font-semibold bg-brand-orange text-white rounded-full hover:bg-orange-600 transition-all duration-200 whitespace-nowrap shadow-sm"
      >
        Planifica tu visita
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="menu-toggle"
      class="lg:hidden p-2 rounded-full text-brand-brown hover:bg-brand-cream transition-colors duration-200"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>

  </div>
</header>

<!-- ── Mobile Overlay ─────────────────────────────── -->
<div
  id="mobile-overlay"
  class="fixed inset-0 bg-black/50 z-40 opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
></div>

<!-- ── Mobile Drawer ──────────────────────────────── -->
<div
  id="mobile-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
  class="fixed top-0 right-0 h-full w-[min(320px,90vw)] bg-white z-50 transform translate-x-full transition-transform duration-300 shadow-2xl flex flex-col"
>
  <!-- Drawer header — always white background → positive logo -->
  <div class="flex items-center justify-between px-6 py-5 border-b border-gray-100">
    <a href="/" class="flex items-center gap-3">
      <img
        src={drawerLogo}
        alt="Logo Comunidad de Amor Cristiano"
        class="h-8 w-auto object-contain shrink-0"
      />
      <div class="leading-tight text-brand-brown" style="font-family: 'Plus Jakarta Sans', sans-serif;">
        <span class="block font-extrabold text-[10px] tracking-wide uppercase">Comunidad de</span>
        <span class="block font-extrabold text-[10px] tracking-wide uppercase">Amor Cristiano</span>
      </div>
    </a>
    <button
      id="menu-close"
      class="p-2 rounded-full text-gray-400 hover:text-brand-brown hover:bg-gray-50 transition-colors duration-200"
      aria-label="Cerrar menú"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Nav links -->
  <nav class="flex-1 overflow-y-auto px-4 py-4" aria-label="Menú móvil">
    <ul class="space-y-1">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="mobile-nav-link flex items-center px-4 py-3 text-[15px] font-medium text-gray-700 hover:text-brand-orange hover:bg-brand-cream rounded-xl transition-colors duration-200"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- CTA buttons -->
  <div class="px-6 py-6 border-t border-gray-100 space-y-3">
    <a
      href="/donar"
      class="flex items-center justify-center w-full px-6 py-3 border border-brand-brown text-brand-brown rounded-full font-semibold text-[14px] hover:bg-brand-cream transition-colors duration-200"
    >
      Donar
    </a>
    <a
      href="/primera-vez"
      class="flex items-center justify-center w-full px-6 py-3 bg-brand-orange text-white rounded-full font-semibold text-[14px] hover:bg-orange-600 transition-colors duration-200"
    >
      Planifica tu visita
    </a>
  </div>
</div>

<script>
  const toggle   = document.getElementById('menu-toggle')   as HTMLButtonElement | null;
  const closeBtn = document.getElementById('menu-close')    as HTMLButtonElement | null;
  const overlay  = document.getElementById('mobile-overlay') as HTMLElement | null;
  const drawer   = document.getElementById('mobile-drawer')  as HTMLElement | null;

  function openMenu() {
    drawer?.classList.remove('translate-x-full');
    drawer?.classList.add('translate-x-0');
    overlay?.classList.remove('opacity-0', 'pointer-events-none');
    overlay?.classList.add('opacity-100');
    document.body.classList.add('overflow-hidden');
    toggle?.setAttribute('aria-expanded', 'true');
  }

  function closeMenu() {
    drawer?.classList.remove('translate-x-0');
    drawer?.classList.add('translate-x-full');
    overlay?.classList.remove('opacity-100');
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    document.body.classList.remove('overflow-hidden');
    toggle?.setAttribute('aria-expanded', 'false');
  }

  toggle?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
