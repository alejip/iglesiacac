---
// LatestSermon.astro — fetches the YouTube RSS feed at build time and embeds latest video.
// No API key required; uses the public RSS feed.

const RSS_URL = 'https://www.youtube.com/feeds/videos.xml?channel_id=UC_ZNaSp149neu--PAGTltWA';
const CHANNEL_URL = 'https://www.youtube.com/@iglesiaCAC';

let videoId: string | null = null;
let videoTitle: string = 'Última predicación';
let fetchFailed = false;

try {
  const res = await fetch(RSS_URL, {
    headers: {
      'Accept': 'application/xml, text/xml, */*',
      'User-Agent': 'Mozilla/5.0 (compatible; Astro/build)',
    },
    signal: AbortSignal.timeout(8000),
  });

  if (res.ok) {
    const xml = await res.text();

    // Extract the first <entry> block
    const entryMatch = xml.match(/<entry>([\s\S]*?)<\/entry>/);
    if (entryMatch) {
      const entry = entryMatch[1];

      // Extract videoId
      const idMatch = entry.match(/<yt:videoId>([\w-]+)<\/yt:videoId>/);
      videoId = idMatch?.[1] ?? null;

      // Extract title — first <title> inside the entry
      const titleMatch = entry.match(/<title>([\s\S]*?)<\/title>/);
      if (titleMatch?.[1]) {
        videoTitle = titleMatch[1]
          .replace(/&amp;/g, '&')
          .replace(/&lt;/g, '<')
          .replace(/&gt;/g, '>')
          .replace(/&quot;/g, '"')
          .replace(/&#39;/g, "'")
          .trim();
      }
    }
  } else {
    fetchFailed = true;
  }
} catch (e) {
  fetchFailed = true;
  // Build continues with fallback UI
}

const embedUrl = videoId
  ? `https://www.youtube.com/embed/${videoId}?rel=0&modestbranding=1`
  : null;
---

<section class="bg-brand-cream py-24 px-4">
  <div class="max-w-4xl mx-auto">

    <div class="text-center mb-12">
      <span class="inline-block text-brand-orange font-semibold text-sm uppercase tracking-widest mb-3">
        Predicaciones
      </span>
      <h2 class="text-4xl md:text-5xl font-extrabold text-brand-brown leading-tight">
        Última predicación
      </h2>
      <p class="mt-4 text-gray-500 text-lg">
        Escucha la Palabra de Dios cuando y donde quieras.
      </p>
    </div>

    {embedUrl ? (
      <!-- Video embed -->
      <div class="rounded-2xl overflow-hidden shadow-xl bg-brand-brown aspect-video">
        <!-- data-yt-src: src is set by CookieBanner.astro script only after media cookie consent -->
        <iframe
          data-yt-src={embedUrl}
          title={videoTitle}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          class="w-full h-full"
          loading="lazy"
        />
      </div>
      <p class="mt-5 text-center font-semibold text-brand-brown text-lg">
        {videoTitle}
      </p>
    ) : (
      <!-- Fallback when RSS fetch fails or no video found -->
      <div class="rounded-2xl bg-brand-beige flex flex-col items-center justify-center py-20 px-8 text-center gap-5">
        <div class="w-16 h-16 rounded-full bg-brand-orange/10 flex items-center justify-center">
          <svg class="w-8 h-8 text-brand-orange" viewBox="0 0 24 24" fill="currentColor">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
        </div>
        <div>
          <p class="font-bold text-brand-brown text-lg mb-1">Mira nuestras predicaciones en YouTube</p>
          <p class="text-gray-500 text-sm">Tenemos un archivo completo de mensajes para que crezcas en tu fe.</p>
        </div>
      </div>
    )}

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={CHANNEL_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-8 py-4 bg-brand-brown text-white rounded-full font-semibold text-sm hover:bg-opacity-90 transition-all duration-200 shadow-sm hover:shadow-md"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        Ver todas en YouTube
      </a>
      <a
        href="https://open.spotify.com/show/53iFEeNCBKGXleuWzhFb8j"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-8 py-4 bg-[#1DB954] text-white rounded-full font-semibold text-sm hover:bg-[#1aa34a] transition-all duration-200 shadow-sm hover:shadow-md"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
        </svg>
        Escuchar en Spotify
      </a>
    </div>

  </div>
</section>
