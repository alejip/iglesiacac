---
// Meetings.astro — service times / horarios block

const meetings = [
  {
    day: 'Jueves',
    time: '19:30',
    name: 'Reunión de Oración',
    description: 'Nos unimos para orar juntos. Un espacio íntimo y poderoso.',
    icon: `<path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>`,
    color: 'text-brand-red',
    bg: 'bg-red-50',
  },
  {
    day: 'Viernes',
    time: '19:00',
    name: 'Jóvenes',
    description: 'Espacio especial para jóvenes que quieren vivir su fe con autenticidad.',
    icon: `<path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"/>`,
    color: 'text-brand-orange',
    bg: 'bg-orange-50',
  },
  {
    day: 'Domingo',
    time: '11:30',
    name: 'Domingo en Casa',
    description: 'Nuestra reunión principal de adoración y Palabra. Todos son bienvenidos.',
    icon: `<path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"/>`,
    color: 'text-brand-brown',
    bg: 'bg-amber-50',
  },
  {
    day: 'Domingo',
    time: '19:00',
    name: 'Domingo en Casa',
    description: 'Segunda reunión dominical. Misma calidez, mismo mensaje transformador.',
    icon: `<path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"/>`,
    color: 'text-brand-brown',
    bg: 'bg-amber-50',
  },
];
---

<section id="horarios" class="bg-white py-24 px-4">
  <div class="max-w-5xl mx-auto">

    <div class="text-center mb-14">
      <span class="inline-block text-brand-orange font-semibold text-sm uppercase tracking-widest mb-3">
        Horarios
      </span>
      <h2 class="text-4xl md:text-5xl font-extrabold text-brand-brown leading-tight">
        Te esperamos esta semana
      </h2>
      <p class="mt-4 text-gray-500 text-lg max-w-xl mx-auto">
        Ven cuando quieras. No necesitas avisar, solo aparecer.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {meetings.map(m => (
        <div class="rounded-2xl border border-gray-100 p-6 flex flex-col gap-4 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
          <div class={`w-11 h-11 rounded-xl ${m.bg} flex items-center justify-center`}>
            <svg class={`w-6 h-6 ${m.color}`} viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
              set:html={m.icon} />
          </div>
          <div>
            <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">{m.day}</p>
            <p class="text-3xl font-extrabold text-brand-brown leading-none">{m.time}</p>
          </div>
          <div class="flex-1">
            <p class="font-bold text-brand-brown text-sm">{m.name}</p>
            <p class="text-gray-500 text-sm mt-1 leading-snug">{m.description}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        href="https://maps.app.goo.gl/YVrcvGYhcTeFbdbw5"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-4 bg-brand-cream text-brand-brown rounded-full font-semibold text-sm hover:bg-brand-beige transition-colors duration-200"
      >
        <svg class="w-4 h-4 text-brand-orange" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
        </svg>
        C/ Sor Ángela de la Cruz 6, Córdoba
      </a>
    </div>

  </div>
</section>
