---
import '../styles/theme.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title = 'Iglesia Cristiana en Córdoba | Comunidad de Amor Cristiano',
  description = 'Iglesia cristiana y evangélica en Córdoba. Comunidad de Amor Cristiano — reuniones domingos 11:30 y 20:00 en C/ Sor Ángela de la Cruz 6.',
  image = '/images/hero.jpg',
  imageAlt = 'Comunidad de Amor Cristiano — Iglesia cristiana en Córdoba',
  noindex = false,
} = Astro.props;

const SITE_URL = 'https://iglesiacac.es';
const canonicalURL = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = image.startsWith('http') ? image : `${SITE_URL}${image}`;

const churchJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Church',
  name: 'Comunidad de Amor Cristiano',
  alternateName: 'Iglesia CAC Córdoba',
  url: SITE_URL,
  logo: `${SITE_URL}/images/logo-llama.png`,
  image: `${SITE_URL}/images/hero.jpg`,
  description: 'Iglesia cristiana y evangélica en Córdoba. Fe real y transformadora, grupos célula y misiones.',
  keywords: ['iglesia cristiana Córdoba', 'iglesia evangélica Córdoba', 'iglesia pentecostal Córdoba', 'Comunidad de Amor Cristiano', 'iglesia CAC Córdoba'],
  hasMap: 'https://www.google.com/maps/place/?q=place_id:ChIJVVVVlZ3fbA0RFVtow_CYNs0',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'C/ Sor Ángela de la Cruz 6',
    addressLocality: 'Córdoba',
    postalCode: '14006',
    addressCountry: 'ES',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 37.9013846,
    longitude: -4.7735889,
  },
  telephone: '+34658769351',
  email: 'info@iglesiacac.es',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Thursday',
      opens: '20:00',
      closes: '21:00',
      name: 'Reunión de Oración',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Friday',
      opens: '19:00',
      closes: '21:00',
      name: 'Jóvenes',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Sunday',
      opens: '11:30',
      closes: '13:00',
      name: 'Domingo en Casa',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Sunday',
      opens: '20:00',
      closes: '21:00',
      name: 'Domingo en Casa',
    },
  ],
  sameAs: [
    'https://www.google.com/maps/place/?q=place_id:ChIJVVVVlZ3fbA0RFVtow_CYNs0',
    'https://www.youtube.com/@iglesiaCAC',
    'https://www.instagram.com/IglesiaCAC',
    'https://www.facebook.com/IglesiaCAC',
  ],
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Comunidad de Amor Cristiano',
  url: SITE_URL,
  description: 'Iglesia cristiana en Córdoba. Reuniones domingos a las 11:30 y 20:00.',
  inLanguage: 'es-ES',
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Comunidad de Amor Cristiano" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#401c14" />

    <!-- Canonical + hreflang -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Comunidad de Amor Cristiano" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/logo-llama.png" />
    <link rel="apple-touch-icon" href="/images/logo-llama.png" />

    <!-- Fonts: Inter + Plus Jakarta Sans (carga async para no bloquear render) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      />
    </noscript>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(churchJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

    <!-- Slot para schemas adicionales por página -->
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
