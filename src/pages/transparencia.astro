---
import BaseLayout from '../layouts/BaseLayout.astro';

const cards = [
  {
    title: 'Información Institucional, organizativa y de planificación',
    description: 'Estatutos, órganos de gobierno, estructura organizativa, planes estratégicos y memoria de actividades.',
    icon: `<path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/>`,
  },
  {
    title: 'Transparencia voluntaria y buenas prácticas',
    description: 'Compromisos éticos, código de conducta, política de protección de datos y otras iniciativas de buen gobierno.',
    icon: `<path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>`,
    doc: {
      label: 'Prevención de delitos y buenas prácticas 2025',
      href: '/documentos/prevencion-delitos-buenas-practicas-2025.pdf',
    },
  },
];
---

<BaseLayout
  title="Transparencia — Comunidad de Amor Cristiano"
  description="Información sobre transparencia institucional, económica y buenas prácticas de Comunidad de Amor Cristiano."
>

  <!-- Header -->
  <section class="bg-brand-brown pt-32 pb-20 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <span class="inline-block bg-white/20 text-white text-xs font-bold uppercase tracking-widest rounded-full px-4 py-2 mb-6">
        Transparencia
      </span>
      <h1 class="text-5xl md:text-6xl font-extrabold text-white leading-tight mb-6">
        Transparencia
      </h1>
      <p class="text-xl text-white/75 leading-relaxed max-w-xl mx-auto">
        Nos comprometemos con la honestidad y la rendición de cuentas en todo lo que hacemos.
      </p>
    </div>
  </section>

  <!-- Cards -->
  <section class="bg-brand-cream py-20 px-4">
    <div class="max-w-5xl mx-auto">

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto">
        {cards.map(card => (
          <div class="bg-white rounded-2xl p-8 flex flex-col gap-5 shadow-sm border-2 border-transparent hover:border-brand-orange transition-colors duration-300">
            <div class="w-12 h-12 rounded-2xl bg-brand-cream flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-brand-orange" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <Fragment set:html={card.icon} />
              </svg>
            </div>
            <div class="flex-1">
              <h2 class="font-extrabold text-brand-brown text-base leading-snug mb-3">{card.title}</h2>
              <p class="text-gray-500 text-sm leading-relaxed">{card.description}</p>
            </div>
            {card.doc ? (
              <a
                href={card.doc.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-brand-orange text-xs font-semibold mt-auto hover:underline"
              >
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
                {card.doc.label}
              </a>
            ) : (
              <span class="inline-flex items-center gap-1.5 text-brand-brown/30 text-xs font-semibold mt-auto">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Próximamente disponible
              </span>
            )}
          </div>
        ))}
      </div>

      <!-- Scripture -->
      <blockquote class="mt-14 border-l-4 border-brand-orange pl-6 py-2">
        <p class="text-gray-600 italic leading-relaxed">
          "Procuramos hacer las cosas honradamente, no solo delante del Señor sino también delante de los hombres."
        </p>
        <cite class="text-brand-orange font-semibold text-sm mt-2 block">2 Corintios 8:21</cite>
      </blockquote>

    </div>
  </section>

</BaseLayout>
