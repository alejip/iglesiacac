---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import dale5Logo from '../assets/images/dale5_logo.svg';

const habits = [
  {
    number: '01',
    title: 'Orar',
    description: 'Ora por tus 5 personas cada día, por nombre. Pídele a Dios que las atraiga a Jesús, que quite la ceguera espiritual y abra sus corazones al Evangelio.',
    icon: `<path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>`,
  },
  {
    number: '02',
    title: 'Escuchar',
    description: 'Conócelas de verdad. Pregúntales cómo están. Sé presente, interésate genuinamente por su vida, sus sueños y sus preocupaciones.',
    icon: `<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>`,
  },
  {
    number: '03',
    title: 'Comer',
    description: 'Comparte una comida con ellas. La mesa derriba barreras. Jesús comía con todos — y esos momentos cambiaron vidas para siempre.',
    icon: `<path d="M6 2h1v5H6V2zm2 0h1v5H8V2zm-1.5 5h2v11h-2V7zm5.5-5h1.5v16H12V2z"/>`,
  },
  {
    number: '04',
    title: 'Servir',
    description: 'Únete a su necesidad. Busca una forma práctica de ayudarlas — en lo cotidiano, en lo concreto. El servicio habla donde las palabras no llegan.',
    icon: `<path d="M2 7h1v5H2V7zm2 0h1v5H4V7zm2 0h1v5H6V7zM2 12h6v3a1 1 0 01-1 1H3a1 1 0 01-1-1v-3zM12 7h1v5h-1V7zm2 0h1v5h-1V7zm2 0h1v5h-1V7zM12 12h6v3a1 1 0 01-1 1h-4a1 1 0 01-1-1v-3z"/>`,
  },
  {
    number: '05',
    title: 'Compartir',
    description: 'Cuando el momento llegue, comparte de Jesús con naturalidad. No hace falta tener todas las respuestas — solo contar lo que Él ha hecho en tu vida.',
    icon: `<path d="M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 10.895-1.789l-4.94-2.47a3.027 3.027 0 000-.74l4.94-2.47C13.456 7.68 14.19 8 15 8z"/>`,
  },
];

const prayerPoints = [
  'Que Dios los atraiga a Jesús.',
  'Que quite la ceguera espiritual de sus ojos.',
  'Que les conceda arrepentimiento.',
  'Que nos dé valentía para compartir el Evangelio con ellos.',
  'Que los salve a ellos y a sus familias.',
];
---

<BaseLayout
  title="Dale 5 — Campaña de Oración y Evangelismo | Comunidad de Amor Cristiano"
  description="Únete a Dale 5, una campaña de oración y evangelismo impulsada por Oremos Por Todos. Ora por 5 personas por nombre y preséntales a Jesús."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://iglesiacac.es/' },
        { '@type': 'ListItem', position: 2, name: 'Dale 5', item: 'https://iglesiacac.es/dale-5' },
      ],
    })} />
  </Fragment>

  <!-- ── Hero ──────────────────────────────────────────── -->
  <section class="bg-brand-brown pt-32 pb-20 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <span class="inline-block bg-white/20 text-white text-xs font-bold uppercase tracking-widest rounded-full px-4 py-2 mb-6">
        Oración y Evangelismo
      </span>
      <Image
        src={dale5Logo}
        alt="Logo Dale 5"
        class="mx-auto mb-6 h-56 w-auto"
        loading="eager"
      />
      <p class="text-xl text-white/75 leading-relaxed max-w-xl mx-auto mb-10">
        Una campaña global para orar por cada persona en el mundo por nombre y presentarles a Jesús.
      </p>
      <a
        href="https://oremosportodos.com/involucrate/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-4 bg-brand-orange text-white rounded-full font-bold text-base hover:bg-orange-600 transition-all duration-200 shadow-lg hover:-translate-y-0.5"
      >
        Registrar mi compromiso
        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- ── ¿Qué es Dale 5? ───────────────────────────────── -->
  <section class="bg-white py-24 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <span class="inline-block text-brand-orange font-semibold text-sm uppercase tracking-widest mb-3">
          ¿Qué es?
        </span>
        <h2 class="text-4xl md:text-5xl font-extrabold text-brand-brown leading-tight">
          Un movimiento global de oración
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="rounded-2xl bg-brand-cream p-8 flex flex-col gap-4">
          <div class="w-12 h-12 rounded-2xl bg-white flex items-center justify-center">
            <svg class="w-6 h-6 text-brand-orange" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
            </svg>
          </div>
          <h3 class="font-extrabold text-brand-brown text-lg">8.000 millones de personas</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            Oremos Por Todos está movilizando al cuerpo de Cristo para orar por cada persona en el mundo por nombre y presentarles a Jesús.
          </p>
        </div>
        <div class="rounded-2xl bg-brand-cream p-8 flex flex-col gap-4">
          <div class="w-12 h-12 rounded-2xl bg-white flex items-center justify-center">
            <svg class="w-6 h-6 text-brand-orange" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
            </svg>
          </div>
          <h3 class="font-extrabold text-brand-brown text-lg">5 minutos al día</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            El compromiso es sencillo: dedicar 5 minutos diarios a orar por 5 personas de tu entorno — vecinos, amigos, compañeros de trabajo, familiares.
          </p>
        </div>
        <div class="rounded-2xl bg-brand-cream p-8 flex flex-col gap-4">
          <div class="w-12 h-12 rounded-2xl bg-white flex items-center justify-center">
            <svg class="w-6 h-6 text-brand-orange" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
            </svg>
          </div>
          <h3 class="font-extrabold text-brand-brown text-lg">Por nombre</h3>
          <p class="text-gray-600 text-sm leading-relaxed">
            No oramos por "la gente". Oramos por personas reales, con nombres y rostros. Esa es la diferencia que lo cambia todo — en ellos y en nosotros.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Propósito ─────────────────────────────────────── -->
  <section class="bg-brand-cream py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-14">
        <span class="inline-block text-brand-orange font-semibold text-sm uppercase tracking-widest mb-3">
          Por qué importa
        </span>
        <h2 class="text-4xl md:text-5xl font-extrabold text-brand-brown leading-tight">
          El propósito detrás de Dale 5
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-2xl bg-white p-8 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-brand-orange flex items-center justify-center mb-5">
            <span class="text-white font-extrabold text-base">1</span>
          </div>
          <p class="text-gray-700 text-lg leading-relaxed">
            Jesús quiere que nos preocupemos por las personas lo suficiente como para <strong class="text-brand-brown">conocerlas y orar por ellas por nombre</strong>. Cuando lo hacemos, Dios nos da Su amor por ellas y empezamos a verlas como Él las ve.
          </p>
        </div>
        <div class="rounded-2xl bg-white p-8 shadow-sm">
          <div class="w-10 h-10 rounded-xl bg-brand-orange flex items-center justify-center mb-5">
            <span class="text-white font-extrabold text-base">2</span>
          </div>
          <p class="text-gray-700 text-lg leading-relaxed">
            Dios comienza a <strong class="text-brand-brown">abrir sus corazones al mensaje del Evangelio</strong>. La oración no es el preludio de la acción — es la acción más poderosa que podemos tomar por alguien.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Estrategia: 5 Hábitos de Jesús ───────────────── -->
  <section class="bg-white py-24 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-14">
        <span class="inline-block text-brand-orange font-semibold text-sm uppercase tracking-widest mb-3">
          La estrategia
        </span>
        <h2 class="text-4xl md:text-5xl font-extrabold text-brand-brown leading-tight">
          Los 5 hábitos de Jesús
        </h2>
        <p class="mt-4 text-gray-500 text-lg max-w-xl mx-auto">
          Jesús no solo predicó — vivió entre las personas. Estos cinco hábitos son el modelo que Él nos dejó.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
        {habits.map(habit => (
          <div class="rounded-2xl bg-brand-cream p-7 flex flex-col gap-4 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
            <div class="flex items-center justify-between">
              <div class="w-12 h-12 rounded-2xl bg-white flex items-center justify-center shadow-sm">
                <svg class="w-6 h-6 text-brand-orange" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
                  set:html={habit.icon} />
              </div>
              <span class="text-3xl font-extrabold text-brand-beige leading-none">{habit.number}</span>
            </div>
            <h3 class="font-extrabold text-brand-brown text-xl">{habit.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{habit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Guía de oración ───────────────────────────────── -->
  <section class="bg-brand-cream py-24 px-4">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-14">
        <span class="inline-block text-brand-orange font-semibold text-sm uppercase tracking-widest mb-3">
          Cómo orar
        </span>
        <h2 class="text-4xl font-extrabold text-brand-brown leading-tight">
          Guía de oración para tus 5
        </h2>
        <p class="mt-4 text-gray-500 text-base">
          Cada día, ora estas cinco peticiones por cada una de tus personas.
        </p>
      </div>
      <ul class="space-y-4">
        {prayerPoints.map((point, i) => (
          <li class="flex items-start gap-5 bg-white rounded-2xl px-7 py-5 shadow-sm">
            <span class="flex-none w-9 h-9 rounded-full bg-brand-orange text-white font-extrabold text-sm flex items-center justify-center shrink-0 mt-0.5">
              {i + 1}
            </span>
            <p class="text-gray-700 text-base leading-relaxed font-medium">{point}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────── -->
  <section class="bg-brand-brown py-20 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <div class="flex justify-center gap-1.5 mb-8">
        <span class="w-2 h-2 rounded-full bg-brand-orange opacity-60"></span>
        <span class="w-2 h-2 rounded-full bg-brand-orange opacity-80"></span>
        <span class="w-2 h-2 rounded-full bg-brand-orange"></span>
      </div>
      <h2 class="text-4xl md:text-5xl font-extrabold text-white leading-tight mb-5">
        ¿Quieres unirte?
      </h2>
      <p class="text-lg text-white/70 leading-relaxed mb-10 max-w-xl mx-auto">
        Elige a tus 5 personas. Empieza a orar por ellas hoy. Juntos podemos alcanzar a toda Córdoba con el amor de Jesús.
      </p>
      <a
        href="https://oremosportodos.com/involucrate/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-4 bg-brand-orange text-white rounded-full font-bold text-base hover:bg-orange-600 transition-all duration-200 shadow-lg hover:-translate-y-0.5"
      >
        Registrar mi compromiso
        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>
  </section>

</BaseLayout>
