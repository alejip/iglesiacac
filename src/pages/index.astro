---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfoCards from '../components/InfoCards.astro';
import AboutSection from '../components/AboutSection.astro';
import Meetings from '../components/Meetings.astro';
import LatestSermon from '../components/LatestSermon.astro';
import MinistriesGrid from '../components/MinistriesGrid.astro';
import CTASection from '../components/CTASection.astro';

const WA_LINK = 'https://wa.me/34658769351?text=Hola%20Comunidad%20de%20Amor%20Cristiano%2C%20me%20gustar%C3%ADa%20m%C3%A1s%20info%20para%20visitaros.';
const MAPS_LINK = 'https://maps.app.goo.gl/YVrcvGYhcTeFbdbw5';

const expectItems = [
  {
    title: 'Adoración',
    description: 'Música que toca el corazón y nos acerca a Dios. Cantamos juntos con autenticidad y pasión.',
    icon: `<path d="M18 3a1 1 0 00-1.196-.98l-10 2A1 1 0 006 5v9.114A4.369 4.369 0 005 14c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2V7.82l8-1.6v5.894A4.37 4.37 0 0015 12c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2V3z"/>`,
  },
  {
    title: 'Palabra',
    description: 'Mensajes bíblicos relevantes y prácticos para tu vida real, siempre con profundidad y claridad.',
    icon: `<path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/>`,
  },
  {
    title: 'Comunidad',
    description: 'Aquí eres conocido por tu nombre. Vivimos la fe juntos en grupos, no solos.',
    icon: `<path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"/>`,
  },
  {
    title: 'Niños y familias',
    description: 'Tus hijos están en buenas manos. Tenemos un programa especial para que ellos también crezcan en fe.',
    icon: `<path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>`,
  },
];
---

<BaseLayout
  title="Comunidad de Amor Cristiano — Iglesia en Córdoba"
  description="Una iglesia cristiana en Córdoba que ama a Jesús y a las personas. Ven, te esperamos."
>

  <!-- ── Hero ────────────────────────────────────────────── -->
  <section class="bg-white min-h-screen flex items-center overflow-hidden">
    <div class="w-full max-w-7xl mx-auto px-6 pt-28 pb-16 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <!-- Left: text content -->
      <div class="flex flex-col justify-center order-2 lg:order-1">

        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 bg-brand-cream border border-brand-beige rounded-full px-4 py-2 mb-8 w-fit">
          <span class="w-2 h-2 rounded-full bg-brand-orange animate-pulse"></span>
          <span class="text-brand-brown text-xs font-semibold uppercase tracking-widest">Córdoba, España</span>
        </div>

        <!-- H1 -->
        <h1 class="text-5xl sm:text-6xl xl:text-7xl font-extrabold text-brand-brown leading-[1.05] tracking-tight mb-6">
          Una iglesia que lleva fruto
          <span class="text-brand-orange"> haciendo discípulos.</span>
        </h1>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-4">
          <a
            href={MAPS_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-8 py-4 bg-brand-orange text-white rounded-full font-bold text-base hover:bg-orange-600 transition-all duration-200 shadow-md hover:shadow-lg hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
            </svg>
            Cómo llegar
          </a>
          <a
            href={WA_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-8 py-4 border-2 border-brand-brown text-brand-brown rounded-full font-bold text-base hover:bg-brand-cream transition-all duration-200"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Hablar por WhatsApp
          </a>
        </div>

        <!-- "Primera vez aquí?" nudge -->
        <p class="mt-8 text-gray-400 text-sm">
          ¿Es tu primera vez?{' '}
          <a href="/primera-vez" class="text-brand-orange hover:text-orange-700 underline underline-offset-2 transition-colors duration-200 font-semibold">
            Esto es para ti →
          </a>
        </p>

      </div>

      <!-- Right: hero photo -->
      <div class="relative order-1 lg:order-2 flex justify-center lg:justify-end">
        <!-- Decorative background blob -->
        <div class="absolute inset-0 bg-brand-cream rounded-3xl -rotate-2 scale-95 opacity-70"></div>
        <!-- Photo -->
        <div class="relative w-full max-w-sm lg:max-w-none aspect-[3/4] rounded-3xl overflow-hidden shadow-2xl">
          <img
            src="/images/hero.jpg"
            alt="Congregación de Comunidad de Amor Cristiano adorando"
            class="w-full h-full object-cover object-center"
            fetchpriority="high"
          />
          <!-- Subtle warm vignette at bottom -->
          <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-black/20 to-transparent"></div>
        </div>
        <!-- Floating badge -->
        <div class="absolute -bottom-4 -left-4 lg:left-auto lg:-right-4 bg-white rounded-2xl shadow-xl px-5 py-4 flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-brand-orange flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-white" viewBox="0 0 20 20" fill="currentColor">
              <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
            </svg>
          </div>
          <div>
            <p class="font-extrabold text-brand-brown text-sm leading-none">Comunidad real</p>
            <p class="text-gray-400 text-xs mt-0.5">Córdoba, España</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ── About ───────────────────────────────────────────── -->
  <AboutSection />

  <!-- ── Quick Info Cards ────────────────────────────────── -->
  <InfoCards />

  <!-- ── Qué puedes esperar ──────────────────────────────── -->
  <section class="bg-white py-24 px-4">
    <div class="max-w-5xl mx-auto">

      <div class="text-center mb-14">
        <span class="inline-block text-brand-orange font-semibold text-sm uppercase tracking-widest mb-3">
          Qué puedes esperar
        </span>
        <h2 class="text-4xl md:text-5xl font-extrabold text-brand-brown leading-tight">
          Cada domingo es especial
        </h2>
        <p class="mt-4 text-gray-500 text-lg max-w-xl mx-auto">
          Preparamos cada reunión para que te encuentres con Dios y con personas que se preocupan por ti.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {expectItems.map(item => (
          <div class="rounded-2xl bg-brand-cream p-7 flex flex-col gap-4 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
            <div class="w-12 h-12 rounded-2xl bg-white flex items-center justify-center shadow-sm">
              <svg class="w-6 h-6 text-brand-orange" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
                set:html={item.icon} />
            </div>
            <h3 class="font-extrabold text-brand-brown text-lg">{item.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a
          href="/primera-vez"
          class="inline-flex items-center gap-2 px-8 py-4 bg-brand-orange text-white rounded-full font-bold text-base hover:bg-orange-600 transition-all duration-200 shadow-sm hover:shadow-md"
        >
          Planifica tu primera visita
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
        </a>
      </div>

    </div>
  </section>

  <!-- ── Meetings / Horarios ────────────────────────────── -->
  <Meetings />

  <!-- ── Latest Sermon ──────────────────────────────────── -->
  <LatestSermon />

  <!-- ── Ministries Grid ────────────────────────────────── -->
  <MinistriesGrid />

  <!-- ── CTA Banner ─────────────────────────────────────── -->
  <CTASection />

</BaseLayout>
