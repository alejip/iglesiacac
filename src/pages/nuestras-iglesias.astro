---
import BaseLayout from '../layouts/BaseLayout.astro';

const iglesias = [
  { nombre: 'Iglesia CAC Córdoba',            tipo: 'IGLESIA',         ciudad: 'Córdoba',               provincia: 'Córdoba',    direccion: 'Avda. Fuente de la Salud s/n Nave 6, 14006 Córdoba',          telefono: '658 769 351', lat: 37.8968723, lon: -4.7736857 },
  { nombre: 'Iglesia CAC Baena',              tipo: 'IGLESIA',         ciudad: 'Baena',                 provincia: 'Córdoba',    direccion: 'Avd. Castro del Rio nº 49, Baena',                            telefono: '625 96 65 37', lat: 37.6173035, lon: -4.3243710 },
  { nombre: 'Iglesia CAC Lucena',             tipo: 'IGLESIA',         ciudad: 'Lucena',                provincia: 'Córdoba',    direccion: 'S. Marcos La Ancha nº 14, Lucena',                            telefono: '660 53 12 83', lat: 37.4091334, lon: -4.4860128 },
  { nombre: 'Iglesia CAC Villanueva',         tipo: 'IGLESIA',         ciudad: 'Villanueva de la Serena', provincia: 'Badajoz',  direccion: 'Polígono Industrial Cagancha Nave 37, Villanueva de la Serena', telefono: '692 21 91 70', lat: 38.9685578, lon: -5.8018620 },
  { nombre: 'Punto de Misión Priego',         tipo: 'PUNTO DE MISIÓN', ciudad: 'Priego de Córdoba',     provincia: 'Córdoba',    direccion: 'Las Canteras nº 5, Priego de Córdoba',                        telefono: '680 375 316', lat: 37.4408047, lon: -4.2096459 },
  { nombre: 'Punto de Misión Rute',           tipo: 'PUNTO DE MISIÓN', ciudad: 'Rute',                  provincia: 'Córdoba',    direccion: 'C/ Córdoba nº 6, Rute',                                       telefono: '660 53 12 83', lat: 37.3297132, lon: -4.3756888 },
  { nombre: 'Punto de Misión Posadas',        tipo: 'PUNTO DE MISIÓN', ciudad: 'Posadas',               provincia: 'Córdoba',    direccion: 'C/ Santiago nº 24, Posadas',                                  telefono: '669 46 04 80', lat: 37.8021949, lon: -5.1098474 },
  { nombre: 'Punto de Misión Fuente Palmera', tipo: 'PUNTO DE MISIÓN', ciudad: 'Fuente Palmera',        provincia: 'Córdoba',    direccion: 'Poeta Rafael Adolfo Téllez nº 9, Fuente Palmera',             telefono: '610 27 91 43', lat: 37.7052835, lon: -5.1056303 },
  { nombre: 'Punto de Misión La Carlota',     tipo: 'PUNTO DE MISIÓN', ciudad: 'La Carlota',            provincia: 'Córdoba',    direccion: 'Avd. de la Paz nº 66, La Carlota',                            telefono: '609 31 35 76', lat: 37.6659127, lon: -4.9331493 },
  { nombre: 'Punto de Misión Montilla',       tipo: 'PUNTO DE MISIÓN', ciudad: 'Montilla',              provincia: 'Córdoba',    direccion: 'C/ Curtidores nº 37, Montilla',                               telefono: '615 33 08 05', lat: 37.5811178, lon: -4.6414726 },
  { nombre: 'Iglesia CAC Granada',            tipo: 'IGLESIA',         ciudad: 'Granada',               provincia: 'Granada',    direccion: 'C/ Maestro Antonio Salazar Capilla, La Chana, Granada',       telefono: '675 934 015',  lat: 37.1882149, lon: -3.6239026 },
  { nombre: 'Punto de Misión Maracena',       tipo: 'PUNTO DE MISIÓN', ciudad: 'Maracena',              provincia: 'Granada',    direccion: 'C/ Encrucijada nº 13, Maracena',                              telefono: '675 934 021',  lat: 37.2067851, lon: -3.6353615 },
  { nombre: 'Punto de Misión Castuera',       tipo: 'PUNTO DE MISIÓN', ciudad: 'Castuera',              provincia: 'Badajoz',    direccion: 'C/ Hernán Cortés 2D, Castuera',                               telefono: '692 219 170',  lat: 38.7268444, lon: -5.5435427 },
];
---

<BaseLayout
  title="Nuestras Iglesias — Comunidad de Amor Cristiano"
  description="Encuentra la iglesia o punto de misión de la Comunidad de Amor Cristiano más cercana a ti. Córdoba, Granada, Badajoz y más."
>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  </Fragment>

  <!-- Hero -->
  <section class="bg-brand-brown pt-32 pb-16 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <span class="inline-block bg-white/20 text-white text-xs font-bold uppercase tracking-widest rounded-full px-4 py-2 mb-6">
        Red de iglesias
      </span>
      <h1 class="text-5xl md:text-6xl font-extrabold text-white leading-tight mb-4">
        Nuestras iglesias
      </h1>
      <p class="text-white/70 text-lg max-w-xl mx-auto">
        Estamos en <strong class="text-white">13 ciudades</strong> a lo largo de las provincias de Córdoba, Extremadura y Granada. Encuentra la más cercana a ti.
      </p>
    </div>
  </section>

  <!-- Split layout: cards izquierda · mapa derecha -->
  <div class="flex flex-col lg:flex-row lg:items-start">

    <!-- Mapa: primero en móvil, derecha en desktop (sticky) -->
    <div class="order-1 lg:order-2 lg:flex-1 lg:sticky lg:top-16 h-[380px] lg:h-[calc(100vh-4rem)]">
      <div id="mapa" style="height:100%;width:100%;"></div>
    </div>

    <!-- Tarjetas: debajo en móvil, izquierda en desktop (scroll propio) -->
    <div class="order-2 lg:order-1 lg:w-[400px] lg:shrink-0 lg:h-[calc(100vh-4rem)] lg:overflow-y-auto bg-brand-cream border-r border-brand-beige">

      <!-- Buscador + Leyenda -->
      <div class="sticky top-0 z-10 bg-white/80 backdrop-blur-sm border-b border-brand-beige">
        <div class="px-4 pt-3 pb-2">
          <div class="relative">
            <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-brand-brown/40 pointer-events-none" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/>
            </svg>
            <input
              id="buscador-ciudad"
              type="search"
              placeholder="Buscar ciudad..."
              class="w-full pl-9 pr-3 py-2 text-sm rounded-lg border border-brand-beige bg-white text-brand-brown placeholder-brand-brown/40 focus:outline-none focus:ring-2 focus:ring-brand-orange/40 focus:border-brand-orange"
            />
          </div>
        </div>
        <div class="flex gap-6 px-5 py-2">
          <span class="flex items-center gap-2 text-xs text-brand-brown font-semibold uppercase tracking-wide">
            <span class="w-3 h-3 rounded-full bg-brand-orange inline-block"></span>
            Iglesia
          </span>
          <span class="flex items-center gap-2 text-xs text-brand-brown font-semibold uppercase tracking-wide">
            <span class="w-3 h-3 rounded-full bg-brand-red inline-block"></span>
            Punto de Misión
          </span>
        </div>
      </div>

      <!-- Lista de tarjetas -->
      <div class="p-4 space-y-3">
        {iglesias.map((ig) => (
          <div class="rounded-xl border border-brand-beige bg-white p-4 flex flex-col gap-2 hover:shadow-sm transition-shadow" data-busqueda={`${ig.ciudad} ${ig.provincia}`.toLowerCase()}>
            <div class="flex items-start justify-between gap-2">
              <h2 class="text-brand-brown font-bold text-sm leading-snug">{ig.nombre}</h2>
              <span class={`shrink-0 text-[9px] font-bold uppercase tracking-wider rounded-full px-2 py-0.5 ${ig.tipo === 'IGLESIA' ? 'bg-brand-orange text-white' : 'bg-brand-red text-white'}`}>
                {ig.tipo === 'IGLESIA' ? 'Iglesia' : 'Punto de Misión'}
              </span>
            </div>

            <p class="text-brand-brown/60 text-xs leading-relaxed">
              <span class="font-semibold text-brand-brown/80">{ig.ciudad}</span><br />
              {ig.direccion}
            </p>

            <a
              href={`tel:+34${ig.telefono.replace(/\s/g,'')}`}
              class="flex items-center gap-1.5 text-brand-brown/70 text-xs hover:text-brand-orange transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
              </svg>
              {ig.telefono}
            </a>

            <a
              href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(ig.direccion + ', ' + ig.ciudad)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1.5 text-brand-orange text-xs font-semibold hover:underline"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
              </svg>
              Cómo llegar
            </a>
          </div>
        ))}
      </div>
    </div>

  </div>

  <script is:inline>
    function quitar_tildes(str) {
      return str.normalize('NFD').replace(/[̀-ͯ]/g, '');
    }
    document.getElementById('buscador-ciudad').addEventListener('input', function () {
      var q = quitar_tildes(this.value.trim().toLowerCase());
      document.querySelectorAll('[data-busqueda]').forEach(function (card) {
        card.style.display = !q || quitar_tildes(card.dataset.busqueda).includes(q) ? '' : 'none';
      });
    });
  </script>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" is:inline></script>
  <script is:inline define:vars={{ iglesias }}>
    (function () {
      var L = window.L;
      if (!L) return;

      var bounds = L.latLngBounds(iglesias.map(function (ig) { return [ig.lat, ig.lon]; }));
      var map = L.map('mapa').fitBounds(bounds, { padding: [32, 32] });

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 18,
      }).addTo(map);

      var estilos = {
        'IGLESIA':         { color: '#e8501d', radius: 11 },
        'PUNTO DE MISIÓN': { color: '#98211e', radius: 9  },
      };

      iglesias.forEach(function (ig) {
        var s = estilos[ig.tipo] || estilos['PUNTO DE MISIÓN'];
        L.circleMarker([ig.lat, ig.lon], {
          radius: s.radius,
          fillColor: s.color,
          color: '#fff',
          weight: 2,
          opacity: 1,
          fillOpacity: 0.9,
        })
          .addTo(map)
          .bindPopup(
            '<div style="font-family:sans-serif;min-width:180px;line-height:1.5">' +
            '<strong style="color:#401c14;font-size:13px">' + ig.nombre + '</strong><br>' +
            '<span style="color:#888;font-size:11px">' + ig.direccion + '</span>' +
            '<div style="margin-top:8px;display:flex;flex-direction:column;gap:4px">' +
            '<a href="tel:+34' + ig.telefono.replace(/\s/g,'') + '" style="color:#e8501d;font-size:11px;font-weight:600;text-decoration:none;display:flex;align-items:center;gap:4px">📞 ' + ig.telefono + '</a>' +
            '<a href="https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(ig.direccion + ', ' + ig.ciudad) + '" target="_blank" rel="noopener noreferrer" style="color:#e8501d;font-size:11px;font-weight:600;text-decoration:none;display:flex;align-items:center;gap:4px">📍 Cómo llegar</a>' +
            '</div>' +
            '</div>'
          );
      });
    })();
  </script>
</BaseLayout>
