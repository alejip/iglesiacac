---
import BaseLayout from '../layouts/BaseLayout.astro';

const WA_DONACION = 'https://wa.me/34658769351?text=Hola%2C%20me%20gustar%C3%ADa%20informaci%C3%B3n%20sobre%20c%C3%B3mo%20donar%20a%20Comunidad%20de%20Amor%20Cristiano.';
---

<BaseLayout
  title="Donar — Comunidad de Amor Cristiano"
  description="Apoya la misión de Comunidad de Amor Cristiano en Córdoba con tu donación."
>

  <!-- ── Page header ───────────────────────────────────── -->
  <section class="bg-brand-brown pt-32 pb-20 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <span class="inline-block bg-white/20 text-white text-xs font-bold uppercase tracking-widest rounded-full px-4 py-2 mb-6">
        Generosidad
      </span>
      <h1 class="text-5xl md:text-6xl font-extrabold text-white leading-tight mb-6">
        Donar
      </h1>
      <p class="text-xl text-white/75 leading-relaxed max-w-xl mx-auto">
        Tu generosidad hace posible que personas y familias sean alcanzadas y transformadas en Córdoba y más allá.
      </p>
    </div>
  </section>

  <!-- ── Why give section ──────────────────────────────── -->
  <section class="bg-brand-cream py-20 px-4">
    <div class="max-w-3xl mx-auto">

      <div class="text-center mb-12">
        <h2 class="text-3xl font-extrabold text-brand-brown mb-4">¿Por qué donar?</h2>
        <p class="text-gray-600 text-lg leading-relaxed max-w-2xl mx-auto">
          En la Biblia, la generosidad es una expresión de confianza en Dios y amor por las personas.
          Cada donación sostiene el ministerio local, ayuda a familias en necesidad y financia misiones.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-14">
        <div class="bg-white rounded-2xl p-6 text-center shadow-sm">
          <div class="w-12 h-12 rounded-2xl bg-brand-cream flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-brand-orange" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"/>
            </svg>
          </div>
          <h3 class="font-bold text-brand-brown text-sm mb-2">Ministerio local</h3>
          <p class="text-gray-500 text-xs leading-relaxed">Sostienes reuniones, células y programas de niños y jóvenes.</p>
        </div>
        <div class="bg-white rounded-2xl p-6 text-center shadow-sm">
          <div class="w-12 h-12 rounded-2xl bg-brand-cream flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-brand-orange" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
            </svg>
          </div>
          <h3 class="font-bold text-brand-brown text-sm mb-2">Ayuda social</h3>
          <p class="text-gray-500 text-xs leading-relaxed">Apoyamos a familias vulnerables con alimentos y necesidades básicas.</p>
        </div>
        <div class="bg-white rounded-2xl p-6 text-center shadow-sm">
          <div class="w-12 h-12 rounded-2xl bg-brand-cream flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-brand-orange" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM4.332 8.027a6.012 6.012 0 011.912-2.706C6.512 5.73 6.974 6 7.5 6A1.5 1.5 0 019 7.5V8a2 2 0 004 0 2 2 0 011.523-1.943A5.977 5.977 0 0116 10c0 .34-.028.675-.083 1H15a2 2 0 00-2 2v2.197A5.973 5.973 0 0110 16v-2a2 2 0 00-2-2 2 2 0 01-2-2 2 2 0 00-1.668-1.973z" clip-rule="evenodd"/>
            </svg>
          </div>
          <h3 class="font-bold text-brand-brown text-sm mb-2">Misiones</h3>
          <p class="text-gray-500 text-xs leading-relaxed">Financiamos proyectos misioneros nacionales e internacionales.</p>
        </div>
      </div>

      <!-- Donation methods -->
      <h2 class="text-2xl font-extrabold text-brand-brown mb-6 text-center">Formas de donar</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-8">

        <!-- Bizum -->
        <div class="bg-white rounded-2xl p-8 flex flex-col gap-4 shadow-sm border-2 border-transparent hover:border-brand-orange transition-colors duration-300">
          <div class="flex items-center gap-3">
            <div class="h-10 flex items-center">
              <img src="/bizum-logo.svg" alt="Bizum" class="h-8 w-auto" />
            </div>
          </div>
          <div class="rounded-xl bg-brand-cream p-5 text-center">
            <p class="text-gray-500 text-sm mb-1">Código Bizum</p>
            <p class="text-brand-brown font-extrabold text-3xl tracking-widest">10208</p>
          </div>
        </div>

        <!-- Bank transfer -->
        <div class="bg-white rounded-2xl p-8 flex flex-col gap-4 shadow-sm border-2 border-transparent hover:border-brand-orange transition-colors duration-300">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-2xl bg-brand-cream flex items-center justify-center">
              <svg class="w-6 h-6 text-brand-orange" viewBox="0 0 20 20" fill="currentColor">
                <path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"/>
                <path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z" clip-rule="evenodd"/>
              </svg>
            </div>
            <h3 class="font-extrabold text-brand-brown text-lg">Transferencia</h3>
          </div>
          <div class="rounded-xl bg-brand-cream p-5 space-y-2">
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">IBAN</span>
              <span class="text-brand-brown font-semibold text-xs">ES79 0049 4532 7629 1000 1238</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-500">Concepto</span>
              <span class="text-brand-brown font-semibold text-xs">DONACIÓN CAC</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Scripture quote -->
      <blockquote class="border-l-4 border-brand-orange pl-6 py-2">
        <p class="text-gray-600 italic leading-relaxed">
          "Cada uno dé como propuso en su corazón: no con tristeza, ni por necesidad, porque Dios ama al dador alegre."
        </p>
        <cite class="text-brand-orange font-semibold text-sm mt-2 block">2 Corintios 9:7</cite>
      </blockquote>

    </div>
  </section>

</BaseLayout>
