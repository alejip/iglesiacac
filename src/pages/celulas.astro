---
import BaseLayout from '../layouts/BaseLayout.astro';

const pasos = [
  { n: '1', titulo: 'Cuéntanos de ti', texto: 'Rellena el formulario de abajo con tus datos y el tipo de grupo que buscas.' },
  { n: '2', titulo: 'Te contactamos', texto: 'En pocos días alguien del equipo se pondrá en contacto contigo para presentarte tu célula.' },
  { n: '3', titulo: 'Visita y decide', texto: 'Asiste sin compromiso. Si te sientes en casa, ya eres parte de la familia.' },
];

const grupos = [
  {
    icono: `<path d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"/>`,
    titulo: 'Adultos',
    texto: 'Grupos mixtos de adultos donde la vida real se comparte con honestidad y fe.',
  },
  {
    icono: `<path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"/>`,
    titulo: 'Familias',
    texto: 'Matrimonios y familias que crecen juntos en la fe y comparten la vida del día a día.',
  },
  {
    icono: `<path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>`,
    titulo: 'Parejas',
    texto: 'Espacio para parejas que quieren fortalecer su relación con Dios como centro.',
  },
  {
    icono: `<path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>`,
    titulo: 'Jóvenes',
    texto: 'Células para jóvenes donde se construyen amistades reales y una fe auténtica.',
  },
];

const dinamica = [
  { emoji: '☕', titulo: 'Bienvenida', texto: 'Empezamos con algo de comer y tiempo para conocernos.' },
  { emoji: '🎵', titulo: 'Adoración', texto: 'Un momento de música y presencia de Dios.' },
  { emoji: '📖', titulo: 'Palabra', texto: 'Estudio bíblico práctico y aplicado a la vida real.' },
  { emoji: '🙏', titulo: 'Oración', texto: 'Oramos los unos por los otros con sinceridad.' },
  { emoji: '💬', titulo: 'Comunidad', texto: 'Compartimos lo que Dios está haciendo en nuestras vidas.' },
  { emoji: '🚀', titulo: 'Visión', texto: 'Nos animamos a vivir la fe más allá de la reunión.' },
];
---

<BaseLayout
  title="Células — Comunidad de Amor Cristiano"
  description="Las células de la CAC son grupos pequeños donde conectar con Dios y con personas reales. Únete a una célula en tu ciudad."
>

  <!-- Hero -->
  <section class="bg-brand-brown pt-32 pb-20 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <span class="inline-block bg-white/20 text-white text-xs font-bold uppercase tracking-widest rounded-full px-4 py-2 mb-6">
        Grupos pequeños
      </span>
      <h1 class="text-5xl md:text-6xl font-extrabold text-white leading-tight mb-6">
        Las células
      </h1>
      <p class="text-white/75 text-xl leading-relaxed max-w-2xl mx-auto">
        Un lugar donde conectar con Dios, generar relaciones sanas y vivir la iglesia de verdad — no solo los domingos.
      </p>
      <a
        href="#unirme"
        class="mt-10 inline-flex items-center gap-2 px-8 py-4 bg-brand-orange text-white rounded-full font-bold text-base hover:bg-orange-600 transition-all duration-200 shadow-md"
      >
        Quiero unirme a una célula
        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- ¿Qué es una célula? -->
  <section class="bg-white py-24 px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <span class="text-brand-orange font-semibold text-sm uppercase tracking-widest">¿Qué es?</span>
        <h2 class="text-4xl md:text-5xl font-extrabold text-brand-brown leading-tight mt-3 mb-6">
          La iglesia que ocurre entre semana
        </h2>
        <p class="text-gray-600 text-lg leading-relaxed mb-4">
          Una célula es un grupo pequeño de personas — entre 8 y 15 — que se reúnen una vez a la semana en un hogar para estudiar la Biblia, orar y hacer comunidad de verdad.
        </p>
        <p class="text-gray-600 text-lg leading-relaxed">
          No es un grupo de estudio frío ni un evento formal. Es familia. Un espacio seguro donde puedes ser tú mismo, compartir tus luchas y crecer junto a otros.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        {[
          { icono: '🏠', texto: 'En casas, cerca de ti' },
          { icono: '❤️', texto: 'Relaciones reales' },
          { icono: '📖', texto: 'Palabra viva' },
          { icono: '🌱', texto: 'Crecimiento real' },
          { icono: '🙌', texto: 'Fe en práctica' },
          { icono: '🤝', texto: 'Apoyo mutuo' },
        ].map(item => (
          <div class="bg-brand-cream rounded-2xl p-5 flex flex-col gap-2">
            <span class="text-3xl">{item.icono}</span>
            <span class="text-brand-brown font-bold text-sm">{item.texto}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Dinámica de una reunión -->
  <section class="bg-brand-cream py-24 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <span class="text-brand-orange font-semibold text-sm uppercase tracking-widest">Cada reunión</span>
        <h2 class="text-4xl md:text-5xl font-extrabold text-brand-brown leading-tight mt-3">
          ¿Qué pasa en una célula?
        </h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-5">
        {dinamica.map(item => (
          <div class="bg-white rounded-2xl p-6 flex flex-col gap-3 shadow-sm hover:shadow-md transition-shadow">
            <span class="text-4xl">{item.emoji}</span>
            <h3 class="font-extrabold text-brand-brown text-lg">{item.titulo}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{item.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Para quién -->
  <section class="bg-white py-24 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-14">
        <span class="text-brand-orange font-semibold text-sm uppercase tracking-widest">Para todos</span>
        <h2 class="text-4xl md:text-5xl font-extrabold text-brand-brown leading-tight mt-3">
          Hay una célula para ti
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {grupos.map(g => (
          <div class="rounded-2xl border border-brand-beige p-7 flex flex-col gap-4 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
            <div class="w-12 h-12 rounded-2xl bg-brand-cream flex items-center justify-center">
              <svg class="w-6 h-6 text-brand-orange" viewBox="0 0 20 20" fill="currentColor" set:html={g.icono} />
            </div>
            <h3 class="font-extrabold text-brand-brown text-lg">{g.titulo}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{g.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section class="bg-brand-brown py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-14">
        <span class="inline-block bg-white/20 text-white text-xs font-bold uppercase tracking-widest rounded-full px-4 py-2 mb-4">Proceso</span>
        <h2 class="text-4xl md:text-5xl font-extrabold text-white leading-tight">
          Así de sencillo
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {pasos.map(p => (
          <div class="flex flex-col gap-4">
            <div class="w-12 h-12 rounded-full bg-brand-orange flex items-center justify-center text-white font-extrabold text-xl shrink-0">
              {p.n}
            </div>
            <h3 class="font-extrabold text-white text-xl">{p.titulo}</h3>
            <p class="text-white/70 text-sm leading-relaxed">{p.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Formulario -->
  <section id="unirme" class="bg-brand-cream py-24 px-4">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-brand-orange font-semibold text-sm uppercase tracking-widest">Únete</span>
        <h2 class="text-4xl md:text-5xl font-extrabold text-brand-brown leading-tight mt-3 mb-4">
          Quiero formar parte
        </h2>
        <p class="text-gray-500 text-lg">Cuéntanos un poco sobre ti y te conectamos con la célula más cercana.</p>
      </div>

      <form id="form-celulas" class="bg-white rounded-3xl shadow-sm p-8 md:p-10 flex flex-col gap-5">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="flex flex-col gap-1.5">
            <label for="nombre" class="text-sm font-semibold text-brand-brown">Nombre completo <span class="text-brand-orange">*</span></label>
            <input id="nombre" name="nombre" type="text" required placeholder="Tu nombre"
              class="px-4 py-3 rounded-xl border border-brand-beige bg-brand-cream text-brand-brown placeholder-brand-brown/30 focus:outline-none focus:ring-2 focus:ring-brand-orange/40 focus:border-brand-orange text-sm" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="email" class="text-sm font-semibold text-brand-brown">Email <span class="text-brand-orange">*</span></label>
            <input id="email" name="email" type="email" required placeholder="tu@email.com"
              class="px-4 py-3 rounded-xl border border-brand-beige bg-brand-cream text-brand-brown placeholder-brand-brown/30 focus:outline-none focus:ring-2 focus:ring-brand-orange/40 focus:border-brand-orange text-sm" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="flex flex-col gap-1.5">
            <label for="telefono" class="text-sm font-semibold text-brand-brown">Teléfono</label>
            <input id="telefono" name="telefono" type="tel" placeholder="600 000 000"
              class="px-4 py-3 rounded-xl border border-brand-beige bg-brand-cream text-brand-brown placeholder-brand-brown/30 focus:outline-none focus:ring-2 focus:ring-brand-orange/40 focus:border-brand-orange text-sm" />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="ciudad" class="text-sm font-semibold text-brand-brown">Ciudad o barrio</label>
            <input id="ciudad" name="ciudad" type="text" placeholder="Ej: Córdoba, La Chana..."
              class="px-4 py-3 rounded-xl border border-brand-beige bg-brand-cream text-brand-brown placeholder-brand-brown/30 focus:outline-none focus:ring-2 focus:ring-brand-orange/40 focus:border-brand-orange text-sm" />
          </div>
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="grupo" class="text-sm font-semibold text-brand-brown">¿A qué tipo de grupo te gustaría unirte?</label>
          <select id="grupo" name="grupo"
            class="px-4 py-3 rounded-xl border border-brand-beige bg-brand-cream text-brand-brown focus:outline-none focus:ring-2 focus:ring-brand-orange/40 focus:border-brand-orange text-sm appearance-none">
            <option value="">Sin preferencia</option>
            <option value="Adultos">Adultos</option>
            <option value="Familias">Familias</option>
            <option value="Parejas">Parejas</option>
            <option value="Jóvenes">Jóvenes</option>
          </select>
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="mensaje" class="text-sm font-semibold text-brand-brown">¿Algo que quieras contarnos? <span class="text-gray-400 font-normal">(opcional)</span></label>
          <textarea id="mensaje" name="mensaje" rows="3" placeholder="Cuéntanos lo que quieras..."
            class="px-4 py-3 rounded-xl border border-brand-beige bg-brand-cream text-brand-brown placeholder-brand-brown/30 focus:outline-none focus:ring-2 focus:ring-brand-orange/40 focus:border-brand-orange text-sm resize-none"></textarea>
        </div>

        <!-- Feedback -->
        <div id="form-feedback" class="hidden rounded-xl px-4 py-3 text-sm font-medium"></div>

        <button type="submit" id="form-submit"
          class="w-full py-4 bg-brand-orange text-white rounded-full font-bold text-base hover:bg-orange-600 transition-all duration-200 shadow-sm hover:shadow-md disabled:opacity-60 disabled:cursor-not-allowed">
          Enviar solicitud
        </button>

        <p class="text-center text-xs text-gray-400">
          Tus datos solo se usarán para contactarte sobre las células de la iglesia.
        </p>
      </form>
    </div>
  </section>

  <script is:inline>
    const form    = document.getElementById('form-celulas');
    const btn     = document.getElementById('form-submit');
    const feedback = document.getElementById('form-feedback');

    function mostrar(tipo, texto) {
      feedback.className = 'rounded-xl px-4 py-3 text-sm font-medium ' +
        (tipo === 'ok'
          ? 'bg-green-50 text-green-800 border border-green-200'
          : 'bg-red-50 text-red-800 border border-red-200');
      feedback.textContent = texto;
      feedback.classList.remove('hidden');
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      btn.disabled = true;
      btn.textContent = 'Enviando…';
      feedback.classList.add('hidden');

      const body = {
        nombre:   form.nombre.value.trim(),
        email:    form.email.value.trim(),
        telefono: form.telefono.value.trim(),
        ciudad:   form.ciudad.value.trim(),
        grupo:    form.grupo.value,
        mensaje:  form.mensaje.value.trim(),
      };

      try {
        const res  = await fetch('/api/celulas-registro', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        const data = await res.json();
        if (res.ok) {
          mostrar('ok', '¡Recibido! En breve alguien del equipo se pondrá en contacto contigo.');
          form.reset();
        } else {
          mostrar('error', data.error || 'Algo ha fallado. Inténtalo de nuevo.');
        }
      } catch {
        mostrar('error', 'Error de conexión. Comprueba tu internet e inténtalo de nuevo.');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Enviar solicitud';
      }
    });
  </script>

</BaseLayout>
